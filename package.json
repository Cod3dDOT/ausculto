{
	"author": "cod3ddot@proton.me",
	"dependencies": {
		"zod": "^4.6.7"
	},
	"description": "Your last Last.fm track, cover art and streaming links as a Vite/Rolldown virtual module.",
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@commitlint/config-conventional": "^21.2.4",
		"@commitlint/types": "^21.2.3",
		"@types/bun": "^1.4.4",
		"lefthook": "^2.2.2",
		"rolldown": "^1.2.15",
		"tsdown": "^0.23.2",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=22"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./runtime": {
			"types": "./dist/runtime.d.mts",
			"default": "./dist/runtime.mjs"
		},
		"./client": {
			"types": "./client.d.ts"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"client.d.ts"
	],
	"homepage": "https://github.com/cod3ddot/ausculto",
	"keywords": [
		"rolldown-plugin",
		"vite-plugin",
		"rolldown",
		"vite",
		"lastfm",
		"now-playing",
		"scrobbling",
		"music",
		"astro"
	],
	"license": "MIT",
	"name": "ausculto",
	"packageManager": "bun@1.4.3",
	"peerDependencies": {
		"rolldown": "^1.0.0"
	},
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cod3ddot/ausculto.git"
	},
	"scripts": {
		"build": "tsdown",
		"lint": "biome check --write",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"typecheck": "tsc"
	},
	"type": "module",
	"types": "./dist/index.d.mts",
	"version": "0.3.0"
}
